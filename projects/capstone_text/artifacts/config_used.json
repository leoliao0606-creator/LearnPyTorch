{
  "seed": 42,
  "dataset": {
    "n_per_label": 700,
    "test_size": 0.2,
    "val_size": 0.2
  },
  "text": {
    "max_len": 12,
    "min_freq": 1
  },
  "train_batch_size": 32,
  "eval_batch_size": 64,
  "baselines": [
    {
      "name": "Unigram-LR",
      "ngram_range": [
        1,
        1
      ],
      "max_iter": 2000
    },
    {
      "name": "Bigram-LR",
      "ngram_range": [
        1,
        2
      ],
      "max_iter": 2000
    }
  ],
  "experiments": [
    {
      "name": "LSTM-Small",
      "embed_dim": 16,
      "hidden_dim": 32,
      "lr": 0.001,
      "epochs": 15
    },
    {
      "name": "LSTM-Medium",
      "embed_dim": 32,
      "hidden_dim": 64,
      "lr": 0.001,
      "epochs": 20
    }
  ]
}